# ─────────────────────────────────────────────────────────────────────────────
# Personal Assistant System · environment
# Copy to .env.local for local development. Enter private values locally or in
# your deployment service. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used in emails and PDFs). Local: http://localhost:3000
APP_URL=http://localhost:3000

# App mode: "live" (your data) or "demo" (isolated, fictional data, no email).
APP_MODE=live

# Default timezone for dates, paydays and reminders (IANA name).
APP_TIMEZONE=America/Santo_Domingo

# Owner allowlist: comma-separated emails allowed to sign in. Invite-only.
OWNER_EMAILS=you@example.com
# Optional: SHA-256 hex digest of a randomly generated private owner access key.
# Leave empty for email-code sign-in. Never store the original key here.
OWNER_ACCESS_KEY_SHA256=

# Secret used to sign session cookies and cron requests. 32+ random characters.
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
APP_SECRET=change-me-to-a-long-random-string

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) stored under
# ./data. Set it to a Postgres connection string for shared phone+desktop data,
# e.g. Supabase (Project Settings → Database → Connection string, "Transaction"
# pooler, port 6543, add ?sslmode=require).
DATABASE_URL=

# ── Email (sign-in codes and reminders) ─────────────────────────────────────
# EMAIL_TRANSPORT: "console" (prints to the terminal and ./data/outbox; no real
# delivery) or "resend" (https://resend.com, requires a verified domain/sender).
EMAIL_TRANSPORT=console
EMAIL_FROM="Adsvio Assistant <assistant@yourdomain.com>"
RESEND_API_KEY=
# Local only: show the sign-in code on screen when using the console transport.
AUTH_DEV_SHOW_CODE=true

# ── Reminders (server-side schedule) ────────────────────────────────────────
# Real delivery stays off until REMINDERS_DELIVERY=on AND you enable reminders
# in Settings. The schedule calls GET /api/cron/reminders with
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends this automatically).
REMINDERS_DELIVERY=off
CRON_SECRET=change-me-too

# ── AI assistant (optional) ─────────────────────────────────────────────────
# Leave empty to use the rule-based assistant only. With a key, the
# conversational assistant answers questions using scoped, structured queries.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── File storage ────────────────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (./data/files) or "supabase" (private bucket).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-files
